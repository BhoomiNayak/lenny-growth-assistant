# =============================================================================
# The Lenny Growth Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env:   cp env.example .env   (Windows: copy env.example .env)
# NEVER commit .env to git.
#
# NOTE: docker-compose.yml already injects the correct values for the containers.
# This .env is primarily used when you run the ingestion script from the HOST
# (which talks to Postgres on localhost:5440 and Ollama on localhost:11434).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME="Lenny Growth Assistant"
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
# Host access (ingestion script, running tests from host): port 5440
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5440/lenny_assistant

# Inside Docker Compose the backend uses (set automatically by docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny_assistant

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Options: ollama | anthropic | openai
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Ollama (Local LLM) — REQUIRED for demo
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# The backend container reaches host Ollama via (set by docker-compose.yml):
#   macOS / Windows: http://host.docker.internal:11434
#   Linux:           http://172.17.0.1:11434

# -----------------------------------------------------------------------------
# Anthropic (Cloud LLM) — OPTIONAL (leave blank to run local-only)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# OpenAI (Cloud LLM / Embeddings Fallback) — OPTIONAL
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# CORS / Security (frontend origin allowlist)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# -----------------------------------------------------------------------------
# Vector Search
# -----------------------------------------------------------------------------
EMBEDDING_DIMENSION=768
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# Transcript Data
# -----------------------------------------------------------------------------
TRANSCRIPT_DATA_DIR=./data/transcripts/episodes

# -----------------------------------------------------------------------------
# Session / Context
# -----------------------------------------------------------------------------
MAX_SESSION_MESSAGES=50
MAX_CONTEXT_MESSAGES=10

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8001
